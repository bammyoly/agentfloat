# ===========================================================================
# AgentFloat gateway — frontend/server/.env
#
# Copy to `.env`. This file holds the AGENT key. It is read only by this Node
# process, which binds to 127.0.0.1. The React app never receives these values.
#
# `scripts/setup-agent.js` writes AGENT_PRIVATE_KEY, AGENT_WALLET_ADDRESS,
# TREASURY_ADDRESS and GATEWAY_SIGNER_ADDRESS here automatically.
# ===========================================================================

# --- REQUIRED for x402 payments --------------------------------------------
# The agent wallet key. Generated by scripts/setup-agent.js.
# Exposure is bounded by this wallet's MUSD balance and the treasury caps.
AGENT_PRIVATE_KEY=

# --- OPTIONAL ---------------------------------------------------------------
# Port for this gateway. Vite proxies /api to http://127.0.0.1:GATEWAY_PORT.
# A PaaS-injected PORT (Render, Railway, Heroku) takes precedence over this, so
# neither has to be set in production.
#GATEWAY_PORT=4022

# Leave this at 127.0.0.1 on a laptop: this process holds a private key, and
# loopback is the whole security model there.
#
# Set it to 0.0.0.0 ONLY to deploy, because a PaaS cannot proxy to 127.0.0.1 and
# a service that binds loopback never passes its health check. Binding 0.0.0.0 is
# safe only with the two locks below configured — the gateway prints the state of
# all three in its startup log so you can see what you shipped.
#GATEWAY_HOST=127.0.0.1

# ===========================================================================
# DEPLOYING (Render / Railway / Fly / a VPS) — read all three
# ===========================================================================
#
# 1. GATEWAY_ALLOWED_ORIGINS — which browser origins may call this gateway.
#    Comma-separated. An entry may use one wildcard for subdomains, e.g.
#    https://*.vercel.app, which matches a subdomain but NOT the shared apex
#    (https://vercel.app is refused — otherwise every Vercel deployment on earth
#    could reach a gateway holding a signing key). Loopback origins are always
#    allowed, so local development needs nothing set.
#    A PUBLIC gateway with this empty refuses every cross-origin browser request
#    and says so in the response body. Fail closed, not open.
#GATEWAY_ALLOWED_ORIGINS=https://your-app.vercel.app
#GATEWAY_ALLOWED_ORIGINS=https://*.vercel.app
#
# 2. GATEWAY_ADMIN_TOKEN — locks /api/pause and /api/unpause.
#    These are the kill switch. Behind loopback an unauthenticated pause was
#    harmless; on a public URL it is a one-line denial of service against a live
#    demo. Set a long random string. When it is set, the caller must send it as
#    the `X-AgentFloat-Admin` header, and a refusal answers 403 `admin_locked`.
#    Unset (the local default) leaves them open, exactly as before.
#    DO NOT put this in frontend/.env as VITE_GATEWAY_ADMIN_TOKEN to make the
#    dashboard button work: a build-time variable is IN the browser bundle, and a
#    published admin token is not a lock. The on-chain treasury pause() — which
#    needs the owner wallet — is the authority that survives a restart anyway.
#GATEWAY_ADMIN_TOKEN=
#
# 3. STATE_DIR — where faucet-state.json, gas-state.json, limits-state.json and
#    telegram-state.json live. Defaults to beside this file.
#    Render's filesystem is EPHEMERAL: without a mounted disk every deploy and
#    restart wipes the faucet cooldowns, the gas-drip caps, the budget audit
#    trail and every Telegram binding — and a restart becomes a way to claim the
#    faucet again. Attach a disk and point this at it (render.yaml mounts one at
#    /var/data). Free-tier services cannot attach a disk.
#STATE_DIR=/var/data
#
# The frontend needs to know where this gateway is: set VITE_GATEWAY_URL on
# Vercel to this service's URL (see frontend/.env). And add this service's URL to
# your Privy app's allowed origins — no, that is the frontend's domain. Both.
# ===========================================================================

# Where the demo seller's MUSD lands. Defaults to the treasury owner so the
# payment is visible on-chain. MUST be set explicitly in production: the x402
# middleware silently falls back to Mezo's hosted demo address otherwise.
#SELLER_PAY_TO=0xYourOwnerAddress

# Price of the built-in demo endpoint.
#SELLER_PRICE=$0.001

# Same facilitator serves Mezo testnet and mainnet.
#FACILITATOR_URL=https://facilitator.vativ.io

# Comma-separated endpoint prefixes the agent may pay. Empty = any public URL,
# still subject to the on-chain caps. Example:
#ALLOWED_ENDPOINTS=http://127.0.0.1:4022/paid,https://demo.vativ.io

# A FUNDED key authorised as the agent's `gateway` in the treasury, used to
# write payment receipts and denials on-chain. Without it, receipts stay
# gateway-local and the UI labels them as such. This is the deployer key in the
# demo; in production give the gateway its own wallet with a little BTC for gas.
#GATEWAY_SIGNER_PRIVATE_KEY=

# --- SELF-SERVICE BUDGET (optional) -----------------------------------------
# A user changes THEIR OWN agent's caps by signing a challenge from the app; the
# gateway applies it with the owner key (GATEWAY_SIGNER_PRIVATE_KEY above, which
# must be the treasury owner). These are the CEILING a user may move inside —
# defaults match what the faucet grants, so nobody can exceed the protocol's idea
# of a testnet agent. The contract stays onlyOwner: an agent can never raise its
# own limit on chain, which is what makes the cap a cap.
#USER_PER_CALL_MAX_MUSD=5
#USER_DAILY_CAP_MUSD=50
#USER_MIN_PER_CALL_MUSD=0.001

# --- TELEGRAM ALERTS (optional, Wave 1) --------------------------------------
# 1. Message @BotFather on Telegram -> /newbot -> copy the token.
# 2. Paste it here as TELEGRAM_BOT_TOKEN, and the bot's @username as
#    TELEGRAM_BOT_USERNAME (used to build the one-click t.me/<bot>?start=<code>
#    subscribe link; without it the app shows the code to paste by hand).
# 3. Restart the gateway. Users connect from the app's Alerts page, which issues
#    a code bound to their agent address by a signature from that wallet.
#
# Long polling, not a webhook: a webhook needs a public HTTPS URL and this
# gateway runs on a laptop. Exactly ONE process may poll a token — a second
# gateway logs a 409 conflict.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_BOT_USERNAME=
# Seconds between on-chain watcher ticks for subscribed agents (default 20).
#TELEGRAM_WATCH_SECONDS=20

# --- GAS DRIP (optional) -----------------------------------------------------
# A Privy-created agent wallet holds MUSD but no native BTC, so it cannot send
# `MUSD.approve(Permit2, …)` — the one transaction every x402 payment depends on.
# The gateway can send that dust from the operator key, from the app, with the
# same nonce+signature auth as the faucet. Gas on Mezo testnet is close to free
# (observed gasPrice 146 wei, so an approval costs ~1e-11 BTC); the caps below are
# about abuse, not cost. Every value is optional — these are the defaults.
#GAS_DRIP_BTC=0.00005
# Refuse a wallet that already holds at least this much: it can send the tx itself.
# Balance below which a wallet is considered unable to send the approval. The
# effective threshold is the LIVE approval cost × GAS_DRIP_SAFETY_FACTOR, floored at
# this absolute minimum — a hardcoded guess stranded wallets that had just been
# dripped, because 0.00005 BTC is millions of approvals' worth.
#GAS_DRIP_MIN_USABLE_BTC=0.00000001
#GAS_DRIP_SAFETY_FACTOR=50
#GAS_DRIP_COOLDOWN_HOURS=24
#GAS_DRIP_DAILY_CAP_BTC=0.005
#GAS_DRIP_TOTAL_CAP_BTC=0.02
# Hard floor. The owner key keeps this much for its own protocol work (recording
# receipts, registering agents, recalling float) — the drip stops before that.
#GAS_DRIP_OPERATOR_RESERVE_BTC=0.01

# --- daily SPEND cap ---------------------------------------------------------
# The daily cap is enforced against what an agent has actually spent today, summed
# from the treasury's own on-chain payment receipts. This is how many receipts are
# read per check. If every receipt in the window is from today the sum is only a
# lower bound, and the gateway REFUSES rather than guess — raise this if an agent
# legitimately makes hundreds of payments a day.
#DAILY_SPEND_LOOKBACK=300
