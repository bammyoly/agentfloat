{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://agentfloat-server.onrender.com/api/:path*" },
    { "source": "/paid/:path*", "destination": "https://agentfloat-server.onrender.com/paid/:path*" },
    { "source": "/((?!api/|paid/).*)", "destination": "/index.html" }
  ]
}